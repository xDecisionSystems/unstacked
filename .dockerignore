# .git is NOT excluded: the Dockerfile's builder stage reads it to resolve
# the exact commit an image was built from (see GET /version), then discards
# it before the runtime stage -- .git itself never reaches the final image.
.github
.venv
.pytest_cache
.ruff_cache
.coverage
__pycache__
**/__pycache__
*.pyc
dist
build
content
data
site
tests
plans
LOG.md
.env
.env.*
!.env.example
