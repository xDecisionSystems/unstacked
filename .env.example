UNSTACKED_ENVIRONMENT=development
UNSTACKED_CONTENT_REPO_PATH=content
UNSTACKED_DB_PATH=data/app.db
UNSTACKED_CONTENT_LOCK_PATH=data/content.lock

# Signs API bearer tokens. Anyone who knows it can mint a token for any user,
# including an admin. Leave it unset in development and a private random
# secret is generated once at data/api_token_secret. Production refuses to
# start unless this is set explicitly to at least 32 bytes, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# UNSTACKED_API_TOKEN_SECRET=
UNSTACKED_API_TOKEN_SECRET_PATH=data/api_token_secret
UNSTACKED_API_TOKEN_AUDIENCE=unstacked-ai
UNSTACKED_API_TOKEN_TTL_SECONDS=3600
# Browser session cookie lifetime (signed with the secret above, separate salt).
UNSTACKED_SESSION_TTL_SECONDS=43200

UNSTACKED_LOGIN_ATTEMPTS_PER_MINUTE=5
# Number of reverse proxies in front of the app. Must be set behind a proxy,
# or every client shares one rate-limit bucket. Only the last N entries of
# X-Forwarded-For are trusted; anything earlier is client-supplied.
UNSTACKED_TRUSTED_PROXY_HOPS=0
UNSTACKED_MAX_RATE_LIMIT_KEYS=10000

UNSTACKED_MAX_PAGE_BYTES=2000000
UNSTACKED_MAX_EXPORT_BYTES=50000000

# Asset uploads. Only PNG, JPEG, GIF and WebP are accepted, decided by the
# file's own signature rather than its name or declared type; SVG and anything
# else scriptable is refused by design.
# The byte cap is enforced before the body is buffered, so raising it raises
# what one request may cost in memory and spool space.
UNSTACKED_MAX_UPLOAD_BYTES=10485760
# Byte size does not bound an image: a tiny file can declare enormous
# dimensions and only become expensive once something decodes it. These cap
# the decoded bitmap instead, per side and in total.
UNSTACKED_MAX_UPLOAD_DIMENSION=12000
UNSTACKED_MAX_UPLOAD_PIXELS=40000000

# --- Content backup remote -------------------------------------------------
# Runtime changes are stored here and take precedence over the initial
# environment values below. The file and any app-managed token stay under
# data/, never in the exported content repository.
UNSTACKED_BACKUP_CONFIG_PATH=data/backup_config.json
# The git repository the content/ repo is backed up to. Leave unset and no
# remote is configured; content still commits locally. GitHub is one option,
# not a requirement.
# MUST be a PRIVATE repository: the backup is a complete, unfiltered copy of
# the wiki including drafts, with no per-user permissions, exactly like the
# static export. Nothing checks this over the network, so confirm it here or
# the remote is not configured at all.
# UNSTACKED_GITHUB_REMOTE_URL=https://git.example.com/your-org/your-wiki-content.git
UNSTACKED_GITHUB_REMOTE_CONFIRMED_PRIVATE=false
#
# HTTPS: a fine-grained personal access token limited to that one repository
# with Contents read+write and nothing else. The token is never written into
# the remote URL or a git config value; git asks a repo-local helper for it.
# Prefer the file: a path is not a secret, an inline token is.
# UNSTACKED_GITHUB_TOKEN_PATH=data/github_token
# UNSTACKED_GITHUB_TOKEN=
#
# SSH: a repository deploy key with write access, plus the known_hosts entry
# its host key is pinned against. Both are required together — an unpinned
# host key is refused, since accepting an unknown one would hand the deploy
# key to whoever answered. Generate the pin once, from a trusted network:
#   ssh-keyscan github.com > data/known_hosts
# UNSTACKED_GITHUB_SSH_KEY_PATH=data/deploy_key
# UNSTACKED_GITHUB_SSH_KNOWN_HOSTS_PATH=data/known_hosts

# --- AI Action surface -------------------------------------------------------
# The public URL this deployment is reachable at, e.g. https://wiki.example.com.
# Declared as the `servers` entry in the AI-only OpenAPI schema at
# /api/ai/openapi.json — a ChatGPT Action resolves every call against that URL,
# so the schema cannot be imported as an Action without this set. Unset, that
# schema is still valid (useful for Swagger UI/curl) but omits `servers`.
# UNSTACKED_PUBLIC_BASE_URL=https://wiki.example.com
