UNSTACKED_ENVIRONMENT=development
UNSTACKED_CONTENT_REPO_PATH=content
UNSTACKED_DB_PATH=data/app.db
UNSTACKED_CONTENT_LOCK_PATH=data/content.lock

# Signs API bearer tokens. Anyone who knows it can mint a token for any user,
# including an admin. Leave it unset in development and a private random
# secret is generated once at data/api_token_secret. Production refuses to
# start unless this is set explicitly to at least 32 bytes, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# UNSTACKED_API_TOKEN_SECRET=
UNSTACKED_API_TOKEN_SECRET_PATH=data/api_token_secret
UNSTACKED_API_TOKEN_AUDIENCE=unstacked-ai
UNSTACKED_API_TOKEN_TTL_SECONDS=3600

UNSTACKED_LOGIN_ATTEMPTS_PER_MINUTE=5
# Number of reverse proxies in front of the app. Must be set behind a proxy,
# or every client shares one rate-limit bucket. Only the last N entries of
# X-Forwarded-For are trusted; anything earlier is client-supplied.
UNSTACKED_TRUSTED_PROXY_HOPS=0
UNSTACKED_MAX_RATE_LIMIT_KEYS=10000

UNSTACKED_MAX_PAGE_BYTES=2000000
UNSTACKED_MAX_EXPORT_BYTES=50000000
